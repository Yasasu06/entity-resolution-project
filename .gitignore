# --- Python virtual environments -------------------------------------------
# The environment is rebuilt from requirements.txt, so it never gets committed.
.venv/
venv/
env/
ENV/

# --- Python bytecode / build caches ----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# --- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# --- Tooling caches ---------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipython/

# --- Editors ----------------------------------------------------------------
.vscode/
.idea/
*.swp

# --- Operating system junk --------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Secrets ----------------------------------------------------------------
.env

# --- Generated intermediates ------------------------------------------------
# Everything under data/processed/ is produced by running the pipeline and can
# be regenerated from data/raw/, so it is not committed. Same reasoning as not
# storing discarded pairs (docs/DECISIONS.md D21).
data/processed/

# NOTE: dataset CSVs under data/raw/ are deliberately NOT ignored. The
# benchmark data is part of this project and is committed so the repo is
# reproducible from a single clone.

# ots upgrade leaves a backup of the superseded proof; git history has it
*.ots.bak
